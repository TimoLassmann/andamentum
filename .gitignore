# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
dist/
.playwright-mcp/

# Tooling caches
.pytest_cache/
.ruff_cache/

# Local databases (document-store / scribe SQLite files written at runtime)
*.db
*.sqlite
*.sqlite3

# Editor and OS noise
.DS_Store

# Local secrets
.env
.env.local

# Claude Code per-checkout state
.claude/

# Internal planning docs (PRDs, master plans, PR summaries) — kept locally,
# never published. Removed from tracking + history; this keeps it that way.
docs/.internal/

# Local experiment scratch — exploratory scripts kept locally, never published.
# NOTE the glob + negation. `experiments/` on its own excludes the DIRECTORY, and
# git never descends into an excluded directory, so a child .gitignore inside one
# can never re-include anything. `experiments/*` excludes the ENTRIES instead, so
# a specific experiment can be un-excluded and its own .gitignore then applies.
experiments/*
!experiments/docstore_deferred_ingestion/

# Word/PDF artifacts at repo root (generated by whetstone/scribe CLIs)
/*.docx
/*.pdf

# Smoke-run / scratch review outputs at repo root — keep them under
# docs/results/smoke/ if they're worth keeping, otherwise discard.
/smoke_*.md
/reviewed*.docx

# Git worktrees (kept inside the repo so Claude Code's permission scope covers them)
.worktrees/

# scribe & figures local artifacts
benchmarks/*/output/

benchmarks/*/results/

# Scratch directory — local exploratory code dumps, never published.
/scratch/
